{
  "NotebookModel": "LENOVO 20THCTO1WW (ThinkPad P1 Gen 3)",
  "Author": "Local prototype based on TPFanControl-dual-fan",
  "EcPollInterval": 3000,
  "ReadWriteWords": false,
  "CriticalTemperature": 95,
  "CriticalTemperatureOffset": 10,
  "LuaLibraries": ["base"],
  "FanConfigurations": [
    {
      "FanDisplayName": "CPU fan",
      "ReadLuaCode": [
        "local e, selector = ec_read(0x31)",
        "if e then return e, 0 end",
        "e = select(1, ec_write(0x31, selector & 0xFE))",
        "if e then return e, 0 end",
        "local read_error, rpm = ec_read_word(0x84)",
        "if read_error then return read_error, 0 end",
        "return nil, rpm"
      ],
      "WriteLuaCode": [
        "local requested = get_value()",
        "local e, selector = ec_read(0x31)",
        "if e then return e, 0 end",
        "local fan1_selector = selector & 0xFE",
        "for attempt = 1, 5 do",
        "  e = select(1, ec_write(0x31, fan1_selector))",
        "  if e then return e, 0 end",
        "  e = select(1, ec_write(0x2F, requested))",
        "  if e then return e, 0 end",
        "  e = select(1, sleep_ms(100))",
        "  if e then return e, 0 end",
        "  local read_error, actual = ec_read(0x2F)",
        "  if not read_error and actual == requested then return nil, 0 end",
        "  e = select(1, sleep_ms(300))",
        "  if e then return e, 0 end",
        "end",
        "return \"CPU fan level did not latch after 5 attempts\", 0"
      ],
      "ResetLuaCode": [
        "local e, selector = ec_read(0x31)",
        "if e then return e, 0 end",
        "local fan1_selector = selector & 0xFE",
        "e = select(1, ec_write(0x31, fan1_selector))",
        "if e then return e, 0 end",
        "e = select(1, ec_write(0x2F, 0x80))",
        "if e then return e, 0 end",
        "e = select(1, sleep_ms(100))",
        "if e then return e, 0 end",
        "return nil, 0"
      ],
      "MinSpeedValue": 0,
      "MaxSpeedValue": 7,
      "IndependentReadMinMaxValues": true,
      "MinSpeedValueRead": 0,
      "MaxSpeedValueRead": 8000,
      "ResetRequired": true,
      "Sensors": ["@CPU"],
      "TemperatureAlgorithmType": "Max",
      "TemperatureThresholds": [
        { "UpThreshold": 52, "DownThreshold": 0,  "FanSpeed": 0.0 },
        { "UpThreshold": 60, "DownThreshold": 45, "FanSpeed": 14.285714 },
        { "UpThreshold": 64, "DownThreshold": 53, "FanSpeed": 28.571429 },
        { "UpThreshold": 69, "DownThreshold": 58, "FanSpeed": 42.857143 },
        { "UpThreshold": 74, "DownThreshold": 63, "FanSpeed": 57.142857 },
        { "UpThreshold": 80, "DownThreshold": 68, "FanSpeed": 71.428571 },
        { "UpThreshold": 84, "DownThreshold": 74, "FanSpeed": 85.714286 },
        { "UpThreshold": 88, "DownThreshold": 78, "FanSpeed": 99.0 },
        { "UpThreshold": 95, "DownThreshold": 85, "FanSpeed": 100.0 }
      ],
      "FanSpeedPercentageOverrides": [
        { "FanSpeedPercentage": 99.0, "FanSpeedValue": 7, "TargetOperation": "Write" },
        { "FanSpeedPercentage": 100.0, "FanSpeedValue": 71, "TargetOperation": "Write" }
      ]
    },
    {
      "FanDisplayName": "Auxiliary fan",
      "ReadLuaCode": [
        "local e, selector = ec_read(0x31)",
        "if e then return e, 0 end",
        "local fan1_selector = selector & 0xFE",
        "e = select(1, ec_write(0x31, fan1_selector | 0x01))",
        "if e then return e, 0 end",
        "local read_error, rpm = ec_read_word(0x84)",
        "local restore_error = select(1, ec_write(0x31, fan1_selector))",
        "if read_error then return read_error, 0 end",
        "if restore_error then return restore_error, 0 end",
        "return nil, rpm"
      ],
      "WriteLuaCode": [
        "local requested = get_value()",
        "local e, selector = ec_read(0x31)",
        "if e then return e, 0 end",
        "local fan1_selector = selector & 0xFE",
        "for attempt = 1, 5 do",
        "  e = select(1, ec_write(0x31, fan1_selector | 0x01))",
        "  if e then return e, 0 end",
        "  e = select(1, ec_write(0x2F, requested))",
        "  if e then return e, 0 end",
        "  e = select(1, sleep_ms(100))",
        "  if e then return e, 0 end",
        "  local read_error, actual = ec_read(0x2F)",
        "  if not read_error and actual == requested then",
        "    local restore_error = select(1, ec_write(0x31, fan1_selector))",
        "    if restore_error then return restore_error, 0 end",
        "    return nil, 0",
        "  end",
        "  e = select(1, sleep_ms(300))",
        "  if e then return e, 0 end",
        "end",
        "local restore_error = select(1, ec_write(0x31, fan1_selector))",
        "if restore_error then return restore_error, 0 end",
        "return \"Auxiliary fan level did not latch after 5 attempts\", 0"
      ],
      "ResetLuaCode": [
        "local e, selector = ec_read(0x31)",
        "if e then return e, 0 end",
        "local fan1_selector = selector & 0xFE",
        "e = select(1, ec_write(0x31, fan1_selector | 0x01))",
        "if e then return e, 0 end",
        "e = select(1, ec_write(0x2F, 0x80))",
        "if e then return e, 0 end",
        "e = select(1, sleep_ms(100))",
        "if e then return e, 0 end",
        "local restore_error = select(1, ec_write(0x31, fan1_selector))",
        "if restore_error then return restore_error, 0 end",
        "return nil, 0"
      ],
      "MinSpeedValue": 0,
      "MaxSpeedValue": 7,
      "IndependentReadMinMaxValues": true,
      "MinSpeedValueRead": 0,
      "MaxSpeedValueRead": 8000,
      "ResetRequired": true,
      "Sensors": ["@CPU"],
      "TemperatureAlgorithmType": "Max",
      "TemperatureThresholds": [
        { "UpThreshold": 74, "DownThreshold": 0,  "FanSpeed": 0.0 },
        { "UpThreshold": 88, "DownThreshold": 62, "FanSpeed": 99.0 },
        { "UpThreshold": 95, "DownThreshold": 85, "FanSpeed": 100.0 }
      ],
      "FanSpeedPercentageOverrides": [
        { "FanSpeedPercentage": 99.0, "FanSpeedValue": 7, "TargetOperation": "Write" },
        { "FanSpeedPercentage": 100.0, "FanSpeedValue": 71, "TargetOperation": "Write" }
      ]
    }
  ],
  "RegisterWriteConfigurations": []
}
