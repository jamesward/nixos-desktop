+static int Lua_SleepMs(lua_State* l) {
+  const lua_Integer milliseconds = luaL_checkinteger(l, 1);
+
+  if (milliseconds < 0)
+    return Lua_Return_Error(l, "sleep_ms(): milliseconds < 0");
+
+  if (milliseconds > 60000)
+    return Lua_Return_Error(l, "sleep_ms(): milliseconds > 60000");
+
+  sleep_ms((unsigned int) milliseconds);
+
+  return Lua_Return_Integer(l, 0);
+}
